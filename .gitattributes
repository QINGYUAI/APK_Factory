# 统一文本换行，减少 Windows/macOS 混用差异
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf

*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.apk binary
*.p12 binary
*.jar binary
*.so binary
